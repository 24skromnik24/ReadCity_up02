<Window x:Class="ReadCity.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Заказ"
        Icon="/Resourсes/icon.ico"
        Height="500" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="Быстрый подбор товара из каталога:" FontWeight="Bold"/>
            <Grid Margin="0,2,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProductSelectComboBox" Grid.Column="0" Height="32" FontFamily="Comic Sans MS" Margin="0,0,8,0"/>
                <TextBox x:Name="ProductQtyTextBox" Grid.Column="1" Text="1" Height="32" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="+ В заказ" Height="32" Click="AddProductToOrder_Click"/>
            </Grid>
            
            <TextBlock Text="Артикул заказа (формат: Артикул, Кол-во, Артикул, Кол-во) *" FontWeight="Bold"/>
            <TextBox x:Name="ArticlesTextBox" Height="34" Margin="0,2,0,4"
                     ToolTip="Например: А112Т4, 2, G843H5, 1"/>
            <TextBlock Text="Пример: А112Т4, 2, G843H5, 1" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

            <TextBlock Text="Статус заказа *" FontWeight="Bold"/>
            <ComboBox x:Name="StatusComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                      Height="32" FontFamily="Comic Sans MS" Margin="0,2,0,10"
                      SelectionChanged="StatusComboBox_SelectionChanged"/>

            <TextBlock Text="Адрес пункта выдачи *" FontWeight="Bold"/>
            <ComboBox x:Name="PickupPointComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                      Height="32" FontFamily="Comic Sans MS" Margin="0,2,0,10"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Дата заказа *" FontWeight="Bold"/>
                    <DatePicker x:Name="OrderDatePicker" Height="32" FontFamily="Comic Sans MS" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Дата доставки (выдачи) *" FontWeight="Bold"/>
                    <DatePicker x:Name="DeliveryDatePicker" Height="32" FontFamily="Comic Sans MS" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Кнопки Сохранить, Удалить и Отмена -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Button x:Name="DeleteButton" Content="Удалить заказ" Background="#C0392B"
                    HorizontalAlignment="Left" Visibility="Collapsed" Click="DeleteButton_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" FontWeight="Bold" Click="SaveButton_Click" Margin="0,0,10,0"/>
                <Button Content="Отмена" Background="{StaticResource SecondaryBgBrush}" Foreground="Black"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
