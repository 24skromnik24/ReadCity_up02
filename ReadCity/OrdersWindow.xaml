<Window x:Class="ReadCity.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Заказы"
        Icon="/Resourсes/icon.ico"
        Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка (#ABCFCE) -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="/Resources/icon.png" Height="50" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="ЧитайГород — Список заказов" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserInfoTextBlock" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Назад" Click="BackButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель управления (только Администратор) -->
        <Border x:Name="AdminOrderPanel" Grid.Row="1" Background="#F4F8F8" BorderBrush="#ABCFCE"
                BorderThickness="0,0,0,1.5" Padding="15,10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Content="+ Добавить заказ" Click="AddOrderButton_Click"/>
                <TextBlock Text="(Двойной клик по заказу — редактирование или удаление)"
                           FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Список заказов по макету из Модуля 4 -->
        <ListBox x:Name="OrdersListBox" Grid.Row="2" Margin="15"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 MouseDoubleClick="OrdersListBox_MouseDoubleClick"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBgBrush}" BorderBrush="#546F94"
                            BorderThickness="1.5" Margin="0,5" Padding="15" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- Слева: Артикул заказа, статус, адрес ПВЗ, дата заказа -->
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <Run Text="Артикул заказа: "/>
                                    <Run Text="{Binding OrderArticles}"/>
                                </TextBlock>

                                <TextBlock Margin="0,2">
                                    <Run Text="Статус заказа: " FontWeight="Bold"/>
                                    <Run Text="{Binding StatusName}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="0,2">
                                    <Run Text="Адрес пункта выдачи: " FontWeight="Bold"/>
                                    <Run Text="{Binding PickupAddress}"/>
                                </TextBlock>

                                <TextBlock Margin="0,2">
                                    <Run Text="Дата заказа: " FontWeight="Bold"/>
                                    <Run Text="{Binding OrderDateFormatted}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Справа: Дата доставки -->
                            <Border Grid.Column="1" BorderBrush="#546F94" BorderThickness="1,0,0,0" Padding="15,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeliveryDateFormatted}" FontSize="17"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
