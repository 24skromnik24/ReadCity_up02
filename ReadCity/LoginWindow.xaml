<Window x:Class="ReadCity.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Авторизация" Height="460" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="/Resourсes/icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с логотипом (#ABCFCE) -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Resourсes/icon.png" Height="60" Stretch="Uniform" Margin="0,0,15,0"/>
                <TextBlock Text="ЧитайГород" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" Margin="45,25,45,20" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="34" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,0,0,22"/>

            <Button Content="Войти" Height="38" FontSize="15" FontWeight="Bold"
                    Click="LoginButton_Click" Margin="0,0,0,12"/>

            <Button Content="Войти как гость" Height="36" FontSize="14"
                    Background="{StaticResource SecondaryBgBrush}" Foreground="Black"
                    Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
