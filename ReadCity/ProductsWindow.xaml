<Window x:Class="ReadCity.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Icon="Resourсes/icon.ico"
        Title="ООО «ЧитайГород» — Список товаров" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка (#ABCFCE) -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBgBrush}" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="/Resourсes/icon.png" Height="50" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="ЧитайГород — Каталог книг" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="UserInfoTextBlock" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button Content="Выход" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска, сортировки, фильтрации (только Менеджер и Администратор) -->
        <Border x:Name="FilterPanel" Grid.Row="1" Background="#F4F8F8" BorderBrush="#ABCFCE"
                BorderThickness="0,0,0,1.5" Padding="15,10" Visibility="Collapsed">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Поиск:" FontSize="12" FontWeight="Bold"/>
                    <TextBox x:Name="SearchTextBox" Width="230" Height="32"
                             TextChanged="FilterControl_Changed"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Сортировка:" FontSize="12" FontWeight="Bold"/>
                    <ComboBox x:Name="SortComboBox" Width="220" Height="32" FontFamily="Comic Sans MS"
                              SelectedIndex="0" SelectionChanged="FilterControl_Changed">
                        <ComboBoxItem Content="По умолчанию"/>
                        <ComboBoxItem Content="Цена: по возрастанию"/>
                        <ComboBoxItem Content="Цена: по убыванию"/>
                        <ComboBoxItem Content="На складе: по возрастанию"/>
                        <ComboBoxItem Content="На складе: по убыванию"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Размер скидки:" FontSize="12" FontWeight="Bold"/>
                    <ComboBox x:Name="DiscountFilterComboBox" Width="165" Height="32" FontFamily="Comic Sans MS"
                              SelectedIndex="0" SelectionChanged="FilterControl_Changed">
                        <ComboBoxItem Content="Все диапазоны"/>
                        <ComboBoxItem Content="0–12,99%"/>
                        <ComboBoxItem Content="13–16,99%"/>
                        <ComboBoxItem Content="17% и более"/>
                    </ComboBox>
                </StackPanel>

                <!-- Кнопка добавления товара (только Администратор) -->
                <Button x:Name="AddProductButton" Content="+ Добавить товар" Height="32"
                        VerticalAlignment="Bottom" Visibility="Collapsed"
                        Click="AddProductButton_Click"/>

                <Button x:Name="OrdersButton" Content="Заказы" Height="32"
                VerticalAlignment="Bottom" Margin="10,0,0,0" Visibility="Collapsed"
                Click="OrdersButton_Click"/>
                
            </WrapPanel>
        </Border>

        <!-- Список карточек товаров -->
        <ListBox x:Name="ProductsListBox" MouseDoubleClick="ProductsListBox_MouseDoubleClick" Grid.Row="2" Margin="15"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding CardBackground}" BorderBrush="#546F94" BorderThickness="1.5"
                            Margin="0,5" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- Слева: Фото товара -->
                            <Border Grid.Column="0" Background="White" BorderBrush="Gray" BorderThickness="1"
                                    Width="135" Height="175" VerticalAlignment="Center">
                                <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                            </Border>

                            <!-- По центру: Текстовые поля по макету из ТЗ -->
                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                    <Run Text="{Binding CategoryName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding ProductName}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Description, TargetNullValue='Описание отсутствует'}"
                                           TextWrapping="Wrap" Margin="0,4"/>

                                <TextBlock>
                                    <Run Text="Производитель: " FontWeight="Bold"/>
                                    <Run Text="{Binding ManufacturerName}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Поставщик: " FontWeight="Bold"/>
                                    <Run Text="{Binding SupplierName}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Цена: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}"
                                               Foreground="{Binding OldPriceForeground}"
                                               TextDecorations="{Binding OldPriceDecorations}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}"
                                               FontWeight="Bold"
                                               Visibility="{Binding DiscountPriceVisibility}"/>
                                </StackPanel>

                                <TextBlock>
                                    <Run Text="Единица измерения: " FontWeight="Bold"/>
                                    <Run Text="{Binding UnitName}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: " FontWeight="Bold"/>
                                    <Run Text="{Binding StockQuantity}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Справа: Действующая скидка -->
                            <Border Grid.Column="2" BorderBrush="#546F94" BorderThickness="1,0,0,0" Padding="10,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая" HorizontalAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="скидка" HorizontalAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                               FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
    
    
</Window>
